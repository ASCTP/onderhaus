{
  "name": "@asctp/onderhaus",
  "version": "0.1.0",
  "private": true,
  "description": "Hosted Stellar gas paymaster for CCTP transfers, so recipients need no XLM",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "key:create": "tsx scripts/create-key.ts",
    "key:list": "tsx scripts/list-keys.ts"
  },
  "dependencies": {
    "@asctp/parabola": "^0.3.1",
    "@stellar/stellar-sdk": "^16.2.0",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^18.0.5",
    "fastify": "^5.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT"
}
