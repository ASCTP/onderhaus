# Copy to .env and fill in. Never commit the filled-in file.
#
# The service holds hot, funded keys. Whoever can read STELLAR_SECRET_KEY can spend the XLM
# in that account, and whoever can read ARC_SECRET_KEY can spend the USDC in that one. The
# service will spend from either on behalf of anyone holding a valid API key.

# The Stellar secret key (S...) of the account that submits mint_and_forward and pays the
# XLM fee. Required. Fund it with XLM, plus the reserves for anything else the account holds.
STELLAR_SECRET_KEY=

# The private key (0x...) of the Arc account that pays that chain's gas, which on Arc is
# native USDC rather than a separate token. Optional: leaving it empty serves Arc to Stellar
# only, refuses Stellar to Arc with a 501, and polls no Arc balance. Set it to a funded key
# to enable the reverse direction.
ARC_SECRET_KEY=

# Which deployment to operate against. Defaults to testnet. Mainnet moves real USDC and
# spends real funds on every completed transfer.
NETWORK=testnet

# Optional Soroban RPC override. The mainnet default is rate-limited and not intended for
# production traffic, so supply a dedicated provider before running on mainnet.
STELLAR_RPC_URL=

# Optional Arc RPC override, for the same reason.
ARC_RPC_URL=

# Where the API key and metering ledger live.
DATABASE_PATH=onderhaus.db

# HTTP listener.
HOST=127.0.0.1
PORT=3000

# Halt a direction when the account that pays for it falls below its floor. Halting is per
# direction, so a low XLM balance stops Arc to Stellar without stopping Stellar to Arc, and
# /readyz reports which legs are still serviceable. The service reports a leg halted until
# its first successful balance read, so this is also the floor below which the leg refuses
# to serve paid traffic.
XLM_LOW_BALANCE_FLOOR=5
XLM_BALANCE_POLL_MS=60000

# The Arc floor is in USDC, measured against the chain's native balance. That balance is
# reported at 18 decimals. It is not a separate asset from the 6-decimal ERC-20 that CCTP
# moves: the two are the same balance at different precisions, so a floor given in the wrong
# scale is wrong by a factor of a trillion without failing loudly.
USDC_LOW_BALANCE_FLOOR=1
USDC_BALANCE_POLL_MS=60000

# Defaults applied to newly created API keys. Per-key values are set at creation time.
DEFAULT_RATE_LIMIT_PER_MINUTE=60

# Per-address ceiling applied to every request except the health probes, including ones
# that present no key or a body the schema rejects. Keep it above the combined per-key
# limits you expect from any single address, or lower it if the service is being flooded.
IP_RATE_LIMIT_PER_MINUTE=600

# How long to wait for Circle's attestation inside a single request before answering 409
# and asking the caller to retry. The SDK default is 300000 (5 minutes), which is a long
# time to hold an HTTP connection, so this is deliberately much shorter.
ATTESTATION_POLL_INTERVAL_MS=3000
ATTESTATION_POLL_TIMEOUT_MS=30000

LOG_LEVEL=info

# Set to true only when the service sits behind a proxy you control, so that the client IP
# used for per-address rate limiting is the real one and not the proxy's.
TRUST_PROXY=false
